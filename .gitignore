# Ignore intermediate simulation outputs; keep only aggregated results for reproducibility

# Missing-outcomes: ignore all intermediate results but allow aggregated CSVs
simulations/missing_outcomes/miss_intermediate_results/**
!simulations/missing_outcomes/miss_intermediate_results/**/*_aggregated.csv

# Complete-data: ignore per-replicate and intermediate files but keep final results
simulations/complete_data/complete_data_results/**
!simulations/complete_data/complete_data_results/**/*_results.csv
!simulations/complete_data/complete_data_results/**/*_replicate_diagnostics.csv
!simulations/complete_data/complete_data_results/**/*_aggregated.csv

# Generic patterns to ignore per-replicate caches and checkpoints
**/replicate_*.csv
**/replicate_*_checkpoint.csv
**/replicate_checkpoint.csv

# Archives and large downloads (keep only if you intentionally add them)
simulations/**/archives/**

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# ignore the datasets from uploading to GitHub. Archived in Zenodo and available on request.
simulations/complete_data/datasets/*.RData
simulations/missing_outcomes/miss_datasets/

# ignore the non_cf scripts from file
simulations/complete_data/scripts/non_cf/*.R

# similarly ignore the single-stage and two-stage non_cf results from repo
simulations/complete_data/complete_data_results/single_stage/
simulations/complete_data/complete_data_results/two_stage/

# ignore all .bash files from repository
# simulations/missing_outcomes/miss_scripts/miss_bash_scripts/*.bash

# ignore complete-data manifests/checkpoints in procedure folders
simulations/complete_data/complete_data_results/single_stage/input_manifest.csv
simulations/complete_data/complete_data_results/two_stage/input_manifest.csv
simulations/complete_data/complete_data_results/single_stage_cf/input_manifest.csv
simulations/complete_data/complete_data_results/two_stage_cf/input_manifest.csv
simulations/complete_data/complete_data_results/single_stage/checkpoint.csv
simulations/complete_data/complete_data_results/two_stage/checkpoint.csv
simulations/complete_data/complete_data_results/single_stage_cf/checkpoint.csv
simulations/complete_data/complete_data_results/two_stage_cf/checkpoint.csv
simulations/complete_data/complete_data_results/single_stage/single_stage_input_manifest.csv
simulations/complete_data/complete_data_results/two_stage/two_stage_input_manifest.csv
simulations/complete_data/complete_data_results/single_stage/single_stage_checkpoint.csv
simulations/complete_data/complete_data_results/two_stage/two_stage_checkpoint.csv

# local sanity checks
tests/

# renv artifacts
renv/library/
renv/staging/
renv/python/
renv/.cache/

# Hide local logs
logs/
logs/missing_outcomes/

# one-off reconciliation helper for legacy missing-outcomes outputs
simulations/missing_outcomes/miss_scripts/reconcile_missing_outputs.R

# Local Colab automation helpers (keep untracked)
simulations/missing_outcomes/miss_scripts/colab_run/

.positai

.DS_Store


# ignore archive files
simulations/missing_outcomes/archives/

#ignore slurm output files
slurm-*.out